# ==============================================================================
# Lotus Tubes - Hostinger Apache / LiteSpeed Web Server Configuration
# Enforces Canonical Domain (Non-WWW), HTTPS, UTF-8 Charset, and Security Headers
# ==============================================================================

# Charset & MIME Encoding Policy (Fixes Seobility Charset Header Issue)
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .xml .json .rss
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Canonical Domain Enforcement: Redirect www.lotustubes.com -> https://lotustubes.com (301 Permanent)
  RewriteCond %{HTTP_HOST} ^www\.lotustubes\.com$ [NC]
  RewriteRule ^(.*)$ https://lotustubes.com/$1 [L,R=301]

  # 2. HTTPS Enforcement: Redirect http://lotustubes.com -> https://lotustubes.com (301 Permanent)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://lotustubes.com/$1 [L,R=301]

  # 3. Serve physical directory index.html directly without trailing-slash redirect
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]

  # 4. Allow existing physical files and directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Route all other requests to index.html for React Router client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Browser Caching Policy
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Security & Content-Type Headers
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Content-Type "text/html; charset=UTF-8"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
