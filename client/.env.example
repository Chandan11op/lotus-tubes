# ==============================================================================
# Lotus Tubes - Frontend Client Environment Configuration Template
# Copy this file to .env in client/ if overriding defaults.
# Only safe public environment variables (VITE_*) belong here.
# NEVER place backend secrets, database URIs, or private API keys in this file.
# ==============================================================================

# Backend API Base URL
# Local development: http://localhost:5000/api
# Production deployment: https://chocolate-goldfinch-515434.hostingersite.com
VITE_API_BASE_URL=https://chocolate-goldfinch-515434.hostingersite.com

# Cloudflare Turnstile Public Site Key (safe to expose in client DOM)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFe8O8egnFRqONZd

# Primary Contact and WhatsApp Numbers (for client header/footer CTAs)
VITE_WHATSAPP_NUMBER=919930430789
