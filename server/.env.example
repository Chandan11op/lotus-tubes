# ==============================================================================
# Lotus Tubes - Server Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# NEVER commit real passwords, API keys, or connection secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Approved Frontend Origin(s) (comma-separated if multiple)
CLIENT_URL=https://lotus-tubes-react-design.vercel.app,http://localhost:5174,http://localhost:5173,http://localhost:1109

# Render / Vercel API Domain References
RENDER_API=https://lotus-tubes.onrender.com
VERCEL_API=https://lotus-tubes-react-design.vercel.app

# MongoDB Connection String (Atlas Cluster or local replica set)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/lotus_tubes?retryWrites=true&w=majority

# Authentication & Security
# In production, JWT_SECRET must be at least 32 characters of high-entropy randomness
JWT_SECRET=generate_a_random_32_character_secret_string_here
JWT_EXPIRES_IN=7d

# Initial Super Admin Provisioning (Chirag Shah - Lotus Tubes)
STAFF_INIT_EMAIL=chirag@lotustubes.com
STAFF_INIT_PASSWORD=provide_a_secure_initial_admin_password_here

# Resend Transactional Email Delivery (https://resend.com)
RESEND_API_KEY=re_placeholder_api_key_here
RESEND_FROM_EMAIL=sales@lotustubes.com
CONTACT_NOTIFICATION_EMAIL=sales@lotustubes.com

# Cloudflare Turnstile Anti-Bot Secret Key (Optional / Recommended)
TURNSTILE_SECRET_KEY=0x4AAAAAAFe8O_placeholder_secret_key

# Meta WhatsApp Business Cloud API (https://developers.facebook.com)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id
